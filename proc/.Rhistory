data = proc_data_2022_tr4)
modelo_7 <- glm(Cambio_hogar ~ Identitaria + Material + Ambiental + Ocupacional +
Satisfación_residen_pond,
data = proc_data_2022_tr4)
# Modelos de regresión logística simple
modelo_1 <- glm(Cambio_hogar ~ Identitaria, data = proc_data_2022_tr4)
modelo_2 <- glm(Cambio_hogar ~ Material, data = proc_data_2022_tr4)
modelo_3 <- glm(Cambio_hogar ~ Ambiental, data = proc_data_2022_tr4)
modelo_4 <- glm(Cambio_hogar ~ Ocupacional, data = proc_data_2022_tr4)
modelo_5 <- glm(Cambio_hogar ~ Satisfación_residen_pond, data = proc_data_2022_tr4)
# Modelos multivariados
modelo_6 <- glm(Cambio_hogar ~ Identitaria + Material + Ambiental + Ocupacional,
data = proc_data_2022_tr4)
modelo_7 <- glm(Cambio_hogar ~ Identitaria + Material + Ambiental + Ocupacional +
Satisfación_residen_pond,
data = proc_data_2022_tr4)
modelsummary(
list(
"Modelo 1" = modelo_1,
"Modelo 2" = modelo_2,
"Modelo 3" = modelo_3,
"Modelo 4" = modelo_4,
"Modelo 5" = modelo_5,
"Modelo 6" = modelo_6,
"Modelo 7" = modelo_7
),
stars = TRUE,
coef_map = c(
"(Intercept)" = "Intercepto",
"Identitaria" = "Identitaria",
"Material" = "Material",
"Ambiental" = "Ambiental",
"Ocupacional" = "Ocupacional",
"Satisfación_residen_pond" = "Satisfacción residencial"
),
statistic = "std.error",
gof_omit = "AIC|BIC|Log.Lik|RMSE",
output = "html"
)
