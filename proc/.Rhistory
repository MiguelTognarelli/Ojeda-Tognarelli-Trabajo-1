ggeffects::ggpredict(modelo_6, terms = c("Identitaria")) %>%
ggplot(aes(x = x, y = predicted)) +
geom_line(size = 1.2, color = "grey") +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2) +
labs(
title = "Efecto de la dimensión identitaria en la decisión de cambio de hogar",
x = "Identitaria",
y = "Probabilidad predicha"
) +
theme_minimal()
ggeffects::ggpredict(modelo_6, terms = c("Material")) %>%
ggplot(aes(x = x, y = predicted)) +
geom_line(size = 1.2, color = "grey") +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2) +
labs(
title = "Efecto de la dimensión material en la decisión de cambio de hogar",
x = "Material",
y = "Probabilidad predicha"
) +
theme_minimal()
